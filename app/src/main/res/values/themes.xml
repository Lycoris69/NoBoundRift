<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal XML theme — the real theming lives in the Compose theme (presentation/theme/).
  This is used only for the splash / window background before Compose inflates.
-->
<resources>
    <style name="Theme.NoBoundRift" parent="android:Theme.Material.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
